{
    "name": "jordanpartridge/packagist-client",
    "description": "Simple integration for packagist",
    "keywords": [
        "Jordan Partridge",
        "laravel",
        "packagist-client"
    ],
    "homepage": "https://github.com/jordanpartridge/packagist-client",
    "license": "MIT",
    "authors": [
        {
            "name": "Jordan Partridge",
            "email": "jordan.l.partridge@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.69||^13.30",
        "saloonphp/saloon": "^4",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.17",
        "nunomaduro/collision": "^8.9.4",
        "larastan/larastan": "^3.9.3",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^3.8.7||^4.4.1",
        "pestphp/pest-plugin-arch": "^3.1.1||^4.0",
        "pestphp/pest-plugin-laravel": "^3.2||^4.1",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "JordanPartridge\\Packagist\\": "src/",
            "JordanPartridge\\Packagist\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JordanPartridge\\Packagist\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-packagist-client --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JordanPartridge\\Packagist\\PackagistServiceProvider"
            ],
            "aliases": {
                "Packagist": "JordanPartridge\\Packagist\\Facades\\Packagist"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
